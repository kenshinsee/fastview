server {
    server_name huhon.xyz www.huhon.xyz;

    root /var/www/huhon.xyz;
    index index.html;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/huhon.xyz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/huhon.xyz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    location /my-files/ {
    	alias /var/www/workspace/;
    	autoindex on;
    	autoindex_format json; # 关键：让 Nginx 返回 JSON 列表

    	auth_basic "Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd;

    	autoindex_exact_size off;
    	charset utf-8;
    	source_charset utf-8;
    	override_charset on;
    	types {
    		text/html   html;
    		text/plain  txt py md log;
    		application/json  json;
    	}

    	add_header 'Access-Control-Allow-Origin' '*';
    }

    location = /favicon.png {
    	alias /var/www/html/favicon.png;
    }

    location /view {
    	alias /var/www/html/viewer.html;
    	default_type text/html;

    	auth_basic "Restricted Area"; # 弹窗显示的提示语
        auth_basic_user_file /etc/nginx/.htpasswd; # 密码文件路径
    }

    location / {
    	# First attempt to serve request as file, then
    	# as directory, then fall back to displaying a 404.
    	try_files $uri $uri/ =404;
    }
}

server {
    if ($host = huhon.xyz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name huhon.xyz www.huhon.xyz;
    listen 80;
    return 404; # managed by Certbot
}