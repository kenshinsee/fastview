server {
    # 1. Update your domain name here
    server_name YOUR_DOMAIN;


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # This location serves the actual files you want to view
    location /my-files/ {
        # 3. Update to the ABSOLUTE path of the directory you want to view
        alias /ABSOLUTE/PATH/TO/YOUR/FILES/;
        autoindex on;
        autoindex_format json; # Required: Nginx returns file list as JSON

        auth_basic "Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd;

        autoindex_exact_size off;
        charset utf-8;
        source_charset utf-8;
        override_charset on;
        types {
            text/html   html;
            text/plain  txt py md log;
            application/json  json;
        }

        add_header 'Access-Control-Allow-Origin' '*';
    }

    # This location serves the favicon
    location = /favicon.png {
        # 4. Update to the ABSOLUTE path of this project's favicon.png
        alias /ABSOLUTE/PATH/TO/PROJECT/favicon.png;
    }

    # This location serves the viewer UI
    location /view {
        # 5. Update to the ABSOLUTE path of this project's viewer.html
        alias /ABSOLUTE/PATH/TO/PROJECT/viewer.html;
        default_type text/html;

        auth_basic "Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location / {
        return 301 /view;
    }
}

server {
    if ($host = YOUR_DOMAIN) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name YOUR_DOMAIN; 
    listen 80;
    return 404; # managed by Certbot
}